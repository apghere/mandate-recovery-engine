# Copy this to .env and fill in real values. .env is gitignored — never commit it.

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

DATABASE_URL=postgresql://mre:mre@localhost:5432/mre
SIMULATOR_URL=http://localhost:8001

# Decline-string normaliser + notice generator (docs K.2, K.5). Optional:
# absent key -> every normalisation falls back to dictionary/UNKNOWN, which
# is a designed-for degraded mode (docs M.1), not an error.
ANTHROPIC_API_KEY=
